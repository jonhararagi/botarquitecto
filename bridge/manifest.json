{
  "manifest_version": 3,
  "name": "Bridge — ChatGPT Loop",
  "version": "0.2.0",
  "description": "Local control window for relaying messages between two normal ChatGPT tabs.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open BRIDGE"
  }
}