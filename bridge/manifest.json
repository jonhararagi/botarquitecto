{
  "manifest_version": 3,
  "name": "Bridge — ChatGPT Loop",
  "version": "0.8.0",
  "description": "Browser-only multi-session bridge using the source chat response action to isolate origin turns.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open BRIDGE"
  }
}
